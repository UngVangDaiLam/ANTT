# Sao chép thành server/.env rồi sửa giá trị. KHÔNG commit file .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://securenotes:securenotes@localhost:5432/securenotes
# Các origin được phép gửi request thay đổi dữ liệu (chống CSRF), cách nhau bởi dấu phẩy.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Bí mật của server để sinh salt giả khi email không tồn tại (chống dò email).
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SERVER_SECRET=doi-gia-tri-nay
