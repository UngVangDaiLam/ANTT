# Sao chép thành deploy/.env rồi điền giá trị. KHÔNG commit deploy/.env.
# Dùng cho docker-compose.prod.yml (triển khai), không dùng cho máy dev.

# localhost để demo trên máy (chứng chỉ tự ký, trình duyệt sẽ cảnh báo),
# hoặc tên miền thật đã trỏ DNS về máy chủ, ví dụ notes.example.vn.
SITE_ADDRESS=localhost

# 0 khi demo localhost. Đặt 31536000 (1 năm) khi có tên miền thật và HTTPS đã chạy ổn.
HSTS_MAX_AGE=0

# Không cần điền tay: `pnpm deploy:up` (hoặc `pnpm deploy:env`) tự chép file này thành deploy/.env và
# sinh ngẫu nhiên mọi ô bí mật còn trống (D92). Muốn tự điền thì tạo mỗi giá trị bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Ba tài khoản database (D90), ba mật khẩu KHÁC nhau:
#   POSTGRES_PASSWORD   superuser, chỉ dùng để tạo hai role dưới (và để quản trị bằng psql);
#   MIGRATE_DB_PASSWORD role sở hữu bảng, chỉ dùng khi chạy migration;
#   APP_DB_PASSWORD     role của server, chỉ đọc/ghi dữ liệu.
POSTGRES_PASSWORD=
MIGRATE_DB_PASSWORD=
APP_DB_PASSWORD=
SERVER_SECRET=
